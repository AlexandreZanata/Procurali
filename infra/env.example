# Example runtime configuration. Copy to a local `.env` (never commit real values).
# Every value below is synthetic. Production requires real secrets from the
# launch owner; see docs/engineering/authentication.md for the live-provider gate.

# Deployment mode: development | test | staging | production.
PROCURALI_ENV=development

# Application database (PostgreSQL 18.6). Required in every environment.
DATABASE_URL=postgres://procurali@localhost:5432/procurali_dev

# Compose PostgreSQL settings (development service in infra/compose.yaml).
# Synthetic values only; production credentials come from the launch owner.
POSTGRES_USER=procurali
POSTGRES_PASSWORD=procurali-dev-only-not-a-secret
POSTGRES_DB=procurali_dev
POSTGRES_PORT=5432

# Disposable test database. Optional; when set it must differ from DATABASE_URL.
# Integration suites require an explicit TEST_DATABASE_URL and refuse the
# application database.
TEST_DATABASE_URL=postgres://procurali_test@localhost:5433/procurali_test_scaffold

# Compose PostgreSQL settings for the disposable test service
# (infra/compose.test.yaml). Always disjoint from development.
TEST_POSTGRES_USER=procurali_test
TEST_POSTGRES_PASSWORD=procurali-test-only-not-a-secret
TEST_POSTGRES_DB=procurali_test_bootstrap
TEST_POSTGRES_PORT=5433

# Phone-proof provider: fake (development/test only) or twilio (live).
# Production refuses "fake" unconditionally.
PHONE_PROVIDER=fake

# Required only when PHONE_PROVIDER=twilio. Supplied by the owner; never commit.
#TWILIO_ACCOUNT_SID=changeme
#TWILIO_AUTH_TOKEN=changeme
#TWILIO_VERIFY_SERVICE_SID=changeme
# Optional: Verify endpoint (default https://verify.twilio.com; loopback HTTP
# only for an isolated test double) and per-exchange timeout in seconds
# (default 10, maximum 60).
#TWILIO_BASE_URL=https://verify.twilio.com
#TWILIO_TIMEOUT_SECS=10

# Session signing key. Required everywhere with no default; production demands at
# least 32 characters. Generate with: openssl rand -hex 32
SESSION_KEY=dev-only-synthetic-not-a-secret

# Phone identity keys. Required everywhere with no default, and stable across
# restarts: one deterministic lookup digest, one authenticated-encryption
# passphrase. Generate with: openssl rand -hex 32
PHONE_LOOKUP_KEY=dev-only-synthetic-lookup-key
PHONE_ENCRYPTION_KEY=dev-only-synthetic-encryption-key

# Deterministic proof code of the fake phone provider. Required with
# PHONE_PROVIDER=fake and refused everywhere else; development/test only.
FAKE_VERIFY_CODE=135790

# Address the served application binds to. Loopback by default; a container
# needs 0.0.0.0 so the proxy can reach it.
#APP_BIND_ADDRESS=127.0.0.1:8080

# Directory holding the built web bundle. Default: web/dist relative to the
# process working directory.
#APP_ASSETS_DIR=web/dist

# Public origin. Required in production (must be https://); optional otherwise.
#PUBLIC_ORIGIN=https://example.invalid

# Fixed clock instant for deterministic tests (RFC3339 UTC). Development/test
# only; production startup refuses it.
#TEST_FIXED_CLOCK=2026-10-15T12:00:00Z
