# Deployment settings template (P18-T02). Copy to infra/env.deploy (which is
# git-ignored and never committed) and fill every CHANGEME value from the
# authorized staging inputs (P18-T07). Nothing here is a real credential.
APP_IMAGE=procurali-app:<revision-tag-never-latest>
DOMAIN=staging-host.example.invalid
POSTGRES_USER=procurali
POSTGRES_PASSWORD=CHANGEME-IN-LOCAL-ENV-FILE
POSTGRES_DB=procurali_prod
# Session/CSRF secrets: server refuses to start without long random values.
SESSION_KEY=CHANGEME-IN-LOCAL-ENV-FILE-AT-LEAST-32-BYTES
# Public origin the backend accepts for unsafe browser calls.
PUBLIC_ORIGIN=https://staging-host.example.invalid
# Phone provider: Twilio live credentials arrive with staging inputs;
# the fake provider is refused outside explicitly disposable stacks.
PHONE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGEME-IN-LOCAL-ENV-FILE
TWILIO_AUTH_TOKEN=CHANGEME-IN-LOCAL-ENV-FILE
TWILIO_VERIFY_SERVICE_SID=CHANGEME-IN-LOCAL-ENV-FILE
